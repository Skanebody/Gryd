{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    },
    "preview-nolinks": {
      "extends": "preview",
      "env": {
        "GRYD_UNIVERSAL_LINKS": "off"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
